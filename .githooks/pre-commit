#!/usr/bin/env bash
# Pre-commit gates scoped to what is staged. Enable once per clone:
#   git config core.hooksPath .githooks
# Full gates: ./validate.sh smoke (CI runs them too).
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only)"
fail=0

if grep -qE '^(substrates|scenarios|tools|verifier|loadgen-common|tasks)/' <<<"$staged"; then
  if ! uv run --frozen python -m tools.generate_tasks --all --check >/tmp/sre-world-gencheck.$$ 2>&1; then
    grep -E '✗|generate_tasks:' /tmp/sre-world-gencheck.$$ | grep -v '≀' | head -20
    echo "pre-commit: tasks/ is out of sync with its sources." \
         "Run: uv run python -m tools.generate_tasks --all  (never hand-edit tasks/; AGENTS.md Rules)" >&2
    fail=1
  fi
  rm -f /tmp/sre-world-gencheck.$$
  if [ -d .cache/incident-arena/.git ] || [ -n "${ARENA_DIR:-}" ]; then
    if ! uv run --frozen python -m tools.arena_parity --arena "${ARENA_DIR:-.cache/incident-arena}" | tail -1 | grep -q ' 20/20 '; then
      echo "pre-commit: Incident Arena parity regressed. Run: ./validate.sh arena; fix the source" \
           "or justify the difference in ALLOWED_DIFFERENCES (tools/arena_parity.py)." >&2
      fail=1
    fi
  fi
fi

if grep -qE '\.md$' <<<"$staged"; then
  if ! uv run --frozen pytest -q -p no:cacheprovider tools/test_doc_links.py >/dev/null 2>&1; then
    uv run --frozen pytest -q -p no:cacheprovider tools/test_doc_links.py 2>&1 | grep -E '^E  ' | head -10
    echo "pre-commit: a doc link or the AGENTS.md map is broken (see above)." >&2
    fail=1
  fi
fi

exit "$fail"
